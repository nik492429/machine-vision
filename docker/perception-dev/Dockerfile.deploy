# Compiles ws/src in the build image, then ships only the install space on a slim runtime image.
ARG BUILD_IMAGE=perception-build:humble-jp6
ARG RUNTIME_BASE=nvcr.io/nvidia/l4t-jetpack:r36.4.0

FROM ${BUILD_IMAGE} AS builder
COPY ws/src /workspace/src
WORKDIR /workspace
RUN . /opt/ros/humble/setup.sh \
    && colcon build --merge-install --install-base /workspace/install \
        --cmake-args -DCMAKE_BUILD_TYPE=Release -DCMAKE_CUDA_ARCHITECTURES=87

FROM ${RUNTIME_BASE} AS runtime
ARG DEBIAN_FRONTEND=noninteractive
ENV LANG=en_US.UTF-8 \
    ROS_DISTRO=humble \
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

RUN apt-get update && apt-get install -y --no-install-recommends \
        locales curl gnupg2 ca-certificates software-properties-common \
    && locale-gen en_US.UTF-8 \
    && add-apt-repository -y universe \
    && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=arm64 signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu jammy main" \
        > /etc/apt/sources.list.d/ros2.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-ros-base \
        ros-humble-rmw-cyclonedds-cpp \
        ros-humble-cv-bridge \
        ros-humble-image-transport \
        ros-humble-pcl-ros \
        ros-humble-tf2-ros \
        python3 python3-pip \
        libtbb12 libboost-serialization1.74.0 libboost-system1.74.0 libboost-filesystem1.74.0 \
        libboost-thread1.74.0 libboost-regex1.74.0 libboost-timer1.74.0 \
        libboost-chrono1.74.0 libboost-date-time1.74.0 \
    && rm -rf /var/lib/apt/lists/*

# GTSAM libs and the Jetson torch/onnxruntime wheels live under /usr/local in the build image
COPY --from=builder /usr/local /usr/local
RUN ldconfig

COPY --from=builder /workspace/install /workspace/install
COPY ros_entrypoint.sh /ros_entrypoint.sh
RUN chmod +x /ros_entrypoint.sh
WORKDIR /workspace
ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]

# Jetson: nvcr.io/nvidia/l4t-jetpack:r36.4.0 (match `cat /etc/nv_tegra_release`), CUDA_ARCHS=87
# x86 (native Linux / WSL2): nvidia/cuda:12.6.3-cudnn-devel-ubuntu22.04, CUDA_ARCHS = your GPU(s), e.g. "75;86;89"
ARG BASE_IMAGE=nvcr.io/nvidia/l4t-jetpack:r36.4.0
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
ARG JETSON_PIP_INDEX=https://pypi.jetson-ai-lab.io/jp6/cu126
ARG TORCH_X86_INDEX=https://download.pytorch.org/whl/cu126
# TensorRT apt version for x86 only; Jetson gets TensorRT from JetPack. Must match CUDA 12.6 packages.
ARG TRT_VERSION=10.3.0.26-1+cuda12.5
ARG CUDA_ARCHS=87

ENV LANG=en_US.UTF-8 \
    ROS_DISTRO=humble \
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=all \
    CUDAARCHS=${CUDA_ARCHS}

# x86 only: JetPack already ships TensorRT, the nvidia/cuda image does not
RUN if [ "$(dpkg --print-architecture)" = "amd64" ]; then \
        apt-get update && apt-get install -y --no-install-recommends \
            libnvinfer10=${TRT_VERSION} libnvinfer-dev=${TRT_VERSION} \
            libnvinfer-plugin10=${TRT_VERSION} libnvinfer-plugin-dev=${TRT_VERSION} \
            libnvonnxparsers10=${TRT_VERSION} libnvonnxparsers-dev=${TRT_VERSION} \
            libnvinfer-bin=${TRT_VERSION} python3-libnvinfer=${TRT_VERSION} \
        && rm -rf /var/lib/apt/lists/*; \
    fi

# ROS 2 Humble + RViz2 + Gazebo Fortress bridge
RUN apt-get update && apt-get install -y --no-install-recommends \
        locales curl gnupg2 lsb-release software-properties-common ca-certificates \
    && locale-gen en_US.UTF-8 \
    && add-apt-repository -y universe \
    && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu jammy main" \
        > /etc/apt/sources.list.d/ros2.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-desktop \
        ros-humble-rmw-cyclonedds-cpp \
        ros-humble-ros-gz \
        ros-humble-cv-bridge \
        ros-humble-image-transport \
        ros-humble-pcl-ros \
        ros-humble-pcl-conversions \
        ros-humble-tf2-ros \
        ros-humble-rosbag2-storage-mcap \
        ros-humble-robot-localization \
        ros-dev-tools \
        python3-colcon-common-extensions python3-rosdep python3-vcstool \
    && rm -rf /var/lib/apt/lists/*

# Math / vision / point cloud libs and build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build git pkg-config \
        libeigen3-dev libpcl-dev libopencv-dev python3-opencv \
        libboost-all-dev libtbb-dev libsuitesparse-dev \
        python3-pip python3-dev python3-venv \
        gdb htop nano \
    && rm -rf /var/lib/apt/lists/*

# CUDA 12.6 wheels: Jetson index on arm64, PyTorch index on x86; numpy<2 for cv_bridge
RUN pip3 install --no-cache-dir --upgrade pip \
    && pip3 install --no-cache-dir "numpy<2" \
    && if [ "$(dpkg --print-architecture)" = "arm64" ]; then \
         pip3 install --no-cache-dir --index-url ${JETSON_PIP_INDEX} --extra-index-url https://pypi.org/simple \
             torch torchvision onnxruntime-gpu; \
       else \
         pip3 install --no-cache-dir --index-url ${TORCH_X86_INDEX} --extra-index-url https://pypi.org/simple \
             torch torchvision onnxruntime-gpu; \
       fi \
    && pip3 install --no-cache-dir onnx evo rosbags matplotlib scipy

WORKDIR /workspace
COPY ros_entrypoint.sh /ros_entrypoint.sh
RUN chmod +x /ros_entrypoint.sh
ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
